{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wildbil2me/edu-style-guide/conformance.schema.json",
  "title": "Educator suite conformance configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "buildCommand", "entries", "deliverySurfaces", "scopes"],
  "properties": {
    "$schema": { "type": "string" },
    "platform": { "const": "bundled" },
    "buildCommand": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["html", "sources"],
        "properties": {
          "html": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "deliverySurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "entry", "build"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "entry": { "type": "string", "minLength": 1 },
          "build": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "built"],
      "properties": {
        "source": { "$ref": "#/$defs/scope" },
        "built": { "$ref": "#/$defs/scope" }
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
