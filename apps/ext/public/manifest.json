{
  "manifest_version": 3,
  "name": "BBStyler",
  "description": "Create Blackbaud-safe class content and copy it to the clipboard.",
  "version": "0.1.0",
  "permissions": ["sidePanel", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open BBStyler" },
  "side_panel": { "default_path": "index.html" }
}
