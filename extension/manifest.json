{
  "manifest_version": 3,
  "name": "Blackbaud Content Composer",
  "description": "Create Blackbaud-safe class content and insert it into the active editor.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Content Composer" },
  "side_panel": { "default_path": "index.html" }
}
