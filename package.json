{
  "name": "bbstyler",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:ext": "vite --config vite.ext.config.ts",
    "build:ext": "vite build --config vite.ext.config.ts",
    "design:check": "node tools/check-design-vendor.mjs && node design/tools/conformance.mjs . --scope=source",
    "design:check:built": "node tools/check-design-vendor.mjs && node design/tools/conformance.mjs . --scope=built",
    "check:release": "node tools/check-release.mjs",
    "lint": "eslint .",
    "test": "npm run test:core && npm run test:design && npm run probe:test",
    "test:core": "node --test tests/core.test.mjs tests/golden.test.mjs",
    "test:design": "node --test tests/design.test.mjs",
    "probe": "node tools/probe/build.mjs",
    "probe:test": "node --test tools/probe/analyze.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "linkedom": "^0.18.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
